# Copia este archivo como .env y completa los valores.
# Para Dokploy usa solo el dominio, sin https ni rutas. Ejemplo: materiales.tudominio.com
DOMAIN=materiales.tudominio.com
# Debe ser la URL exacta del sitio (sin ruta). En producción usa HTTPS.
APP_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
# El servidor no arranca hasta que escribas una contraseña de 12 caracteres o más.
ADMIN_PASSWORD=cambia-esta-contrasena-larga
DATABASE_PATH=data/sion.sqlite
