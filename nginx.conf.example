# Dentro de server{} de tu dominio, con HTTPS ya configurado:
# sustituye materiales.tudominio.com por tu dominio.
server {
    listen 80;
    server_name materiales.tudominio.com;
    # Para publicar, configura HTTPS con tu proveedor o Certbot.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
